{
	admin off
	auto_https off # railway terminates https in front of us
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server

	# css/js urls carry ?v=..., so they can be cached hard; html stays fresh
	@versioned path *.css *.js
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	header / Cache-Control "no-cache"
}
